POSTGRES_DB=production_planning
POSTGRES_USER=planner
POSTGRES_PASSWORD=local_planner_password
DATABASE_URL=postgresql+psycopg://planner:local_planner_password@ppp-postgres:5432/production_planning
APP_PORT=18095
VITE_API_URL=/api
CORS_ORIGINS=http://localhost:18095,http://127.0.0.1:18095,http://localhost:5173
APP_URL=http://127.0.0.1:18095

# mock для локальной демонстрации, ldap для корпоративного контура
AUTH_MODE=mock
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
MOCK_PASSWORD=demo

LDAP_SERVER_URL=ldap://dc.company.local:389
LDAP_BASE_DN=DC=company,DC=local
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_DOMAIN=COMPANY
LDAP_UPN_SUFFIX=company.local
LDAP_ADMIN_GROUP_DN=CN=PLAN-Admins,OU=Groups,DC=company,DC=local
LDAP_PLANNER_GROUP_DN=CN=PLAN-Planners,OU=Groups,DC=company,DC=local
LDAP_MASTER_GROUP_DN=CN=PLAN-Masters,OU=Groups,DC=company,DC=local
PORTAL_ADMIN_LOGINS=
LDAP_CA_FILE=
LDAP_TLS_VALIDATE=true

EMAIL_ENABLED=false
SMTP_HOST=smtp.agrohold.ru
SMTP_PORT=25
SMTP_FROM=planfkportal@agrohold.ru
SMTP_FROM_NAME=PLAN PORTAL
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_CA_FILE=
SMTP_TLS_VALIDATE=true
NOTIFICATION_EMAILS=

CSB_TEST_MODE=true
CSB_ENDPOINT=
CSB_TOKEN=
