# PLAN PORTAL — параметры развёртывания
APP_PORT=18095
APP_BIND=0.0.0.0
APP_URL=http://127.0.0.1:18095
VITE_API_URL=/api
CORS_ORIGINS=http://localhost:18095,http://127.0.0.1:18095

# Авторизация: mock для демонстрации, ldap для корпоративного контура
AUTH_MODE=mock
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=plan_portal_session
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
MOCK_PASSWORD=demo

# PostgreSQL
POSTGRES_DB=production_planning
POSTGRES_USER=planner
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://planner:replace-with-a-strong-password@ppp-postgres:5432/production_planning

# LDAP / Active Directory
LDAP_SERVER_URL=ldap://dc.company.local:389
LDAP_USE_SSL=false
LDAP_START_TLS=false
LDAP_TIMEOUT=10
LDAP_CA_FILE=
LDAP_TLS_VALIDATE=true
LDAP_TLS_SERVERNAME=
LDAP_TLS_MIN_VERSION=TLSv1.2
LDAP_BASE_DN=DC=company,DC=local
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_USER_ATTRIBUTES=sAMAccountName,displayName,mail,memberOf,cn
LDAP_DOMAIN=COMPANY
LDAP_UPN_SUFFIX=company.local
LDAP_NETBIOS_DOMAIN=COMPANY
LDAP_LOGIN_FORMAT=
LDAP_BIND_FORMAT=

# Только первоначальные администраторы задаются через env.
# Планеров, мастеров и просмотр назначайте в веб-админке PLAN PORTAL.
LDAP_ADMIN_GROUP_DN=CN=PLAN-Admins,OU=Groups,DC=company,DC=local
PORTAL_ADMIN_LOGINS=

# SMTP: пароль и TLS остаются в env; адреса и текст писем редактируются в админке.
EMAIL_ENABLED=false
SMTP_HOST=smtp.agrohold.ru
SMTP_PORT=25
SMTP_FROM=planfkportal@agrohold.ru
SMTP_FROM_NAME=PLAN PORTAL
SMTP_REPLY_TO=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH_METHOD=login
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_SERVERNAME=
SMTP_TLS_MIN_VERSION=TLSv1.2
SMTP_CA_FILE=
SMTP_TLS_VALIDATE=true
SMTP_TIMEOUT_MS=10000
NOTIFICATION_EMAILS=
SETTINGS_ENCRYPTION_KEY=

# CSB: до подключения боевого API оставьте тестовый режим.
CSB_TEST_MODE=true
CSB_ENDPOINT=
CSB_TOKEN=
