# PLAN PORTAL — production .env.
# Названия LDAP/SMTP-переменных совпадают с ART Portal: можно перенести в этот
# файл значения соответствующих блоков, не копируя параметры базы данных.
APP_PORT=15500
APP_BIND=0.0.0.0
APP_URL=http://SERVER_HOST_OR_IP:15500
VITE_API_URL=/api
CORS_ORIGINS=http://SERVER_HOST_OR_IP:15500

# Авторизация. В рабочем контуре используйте LDAP, mock оставлен только для
# локальной разработки без корпоративного каталога.
AUTH_MODE=ldap
APP_ENV=production
SESSION_SECRET=replace_with_a_long_random_value
SESSION_COOKIE_NAME=plan_portal_session
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# PostgreSQL
POSTGRES_DB=plan_portal
POSTGRES_USER=plan_portal
POSTGRES_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgresql+psycopg://plan_portal:replace_with_a_strong_password@ppp-postgres:5432/plan_portal

# LDAP / Active Directory — блок совместим с .env ART Portal.
LDAP_SERVER_URL=
LDAP_SERVER=
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_START_TLS=false
LDAP_TIMEOUT=10
LDAP_CA_FILE=/app/certs/agrohold-ca.pem
LDAP_TLS_VALIDATE=true
LDAP_TLS_SERVERNAME=
LDAP_TLS_MIN_VERSION=TLSv1.2
LDAP_PHOTO_CACHE_SECONDS=300
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_USER_ATTRIBUTES=sAMAccountName,displayName,mail,memberOf,distinguishedName
LDAP_SEARCH_LIMIT=12
LDAP_DOMAIN=
LDAP_UPN_SUFFIX=
LDAP_NETBIOS_DOMAIN=
LDAP_LOGIN_FORMAT=userPrincipalName
LDAP_BIND_FORMAT=

# Совместимые с ART Portal поля. LDAP_ALLOWED_GROUP_DN и LDAP_GROUP_ROLE_MAP
# не выдают права в PLAN Portal: доступ планерам, мастерам и просмотр назначает
# администратор на странице «Администрирование → Пользователи и права».
LDAP_ALLOWED_GROUP_DN=
LDAP_ADMIN_GROUP_DN=
PORTAL_ADMIN_LOGINS=
LDAP_GROUP_ROLE_MAP={}

# SMTP — блок совместим с .env ART Portal. Пароль остаётся только в .env;
# получатели, тема и HTML-шаблон редактируются в админке PLAN Portal.
EMAIL_ENABLED=true
SMTP_HOST=smtp.agrohold.ru
SMTP_PORT=25
SMTP_FROM=planfkportal@agrohold.ru
SMTP_FROM_NAME=PLAN PORTAL
SMTP_REPLY_TO=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH_METHOD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_SERVERNAME=smtp.agrohold.ru
SMTP_TLS_MIN_VERSION=TLSv1.2
SMTP_CA_FILE=/app/certs/agrohold-ca.pem
SMTP_TLS_VALIDATE=true
SMTP_TIMEOUT_MS=10000
NOTIFICATION_EMAILS=
# Дополнительные адресаты для обращений «Обратная связь».
FEEDBACK_EMAILS=
SETTINGS_ENCRYPTION_KEY=

# CSB: до подключения боевого API оставьте тестовый режим.
CSB_TEST_MODE=true
CSB_ENDPOINT=
CSB_TOKEN=

# Срок годности: базовый URL, к которому добавляется /<SKU>.
BOM_API_BASE_URL=http://bom.fkportal.agrohold.ru/api/bom-procedure
BOM_TIMEOUT_SECONDS=20
BOM_BASIS_UNITS=1000
SHELF_LIFE_API_BASE_URL=
SHELF_LIFE_TIMEOUT_SECONDS=10

# Внешняя БД простоев. Запрос должен вернуть псевдонимы:
# line_code или line_name, start_at, end_at, downtime_type (partial/full), reason.
# Для mssql+pymssql и пустого DOWNTIME_QUERY автоматически читается
# EQUIPMENT.dbo.EQUIPMENT_STOP: SEQNAME → название линии,
# EQUIP_START_DATE → начало, STOP_DATE → конец (согласованное соответствие).
# Неизвестный SSTOP_TYPE показывается без расчёта потерь; обратные даты — как ошибка.
# Пример (пароль URL-encode; секреты не коммитить):
# DOWNTIME_DATABASE_URL='mssql+pymssql://USER:PASSWORD@SERVER:1433/EQUIPMENT'
DOWNTIME_DATABASE_URL=
DOWNTIME_QUERY=

# DWH: хвостовые буферы. Отдельное подключение только для чтения.
# Пароль и логин в URL должны быть percent-encoded.
PRODUCTION_FACT_DATABASE_URL=
# Пример: PRODUCTION_FACT_DATABASE_URL='mssql+pymssql://LOGIN:PASSWORD@11-vm-dwh01.agrohold.ru:1433/CSB_FK_REP'
PRODUCTION_FACT_DB_SCHEMA=dbo
PRODUCTION_FACT_BUFFER_KC=5498
# Буфер назначения пекарного цеха.
PRODUCTION_FACT_BUFFER_PC=5898
